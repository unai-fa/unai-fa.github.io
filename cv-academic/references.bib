@article{Kern2025,
	author    = {Christoph Kern and Unai Fischer-Abaigar and Jonas Schweisthal and Dennis Frauen and Rayid Ghani and Stefan Feuerriegel and Mihaela van der Schaar and Frauke Kreuter},
	title     = {Algorithms for reliable decision-making need causal reasoning},
	journal   = {Nature Computational Science},
	year      = {2025},
	volume    = {},
	number    = {},
	pages     = {},
	doi       = {10.1038/s43588-025-00814-9},
	issn      = {2662-8457},
	abstract  = {Decision-making inherently involves cause–effect relationships that introduce causal challenges. We argue that reliable algorithms for decision-making need to build upon causal reasoning. Addressing these causal challenges requires explicit assumptions about the underlying causal structure to ensure identifiability and estimatability, which means that the computational methods must successfully align with decision-making objectives in real-world tasks.}
}


